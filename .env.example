# 高德开放平台：应用 -> 添加 Key -> 服务平台选择「Web端(JS API)」
VITE_AMAP_KEY=
# 本地开发填写该 Key 配套的安全密钥；生产环境建议使用下方安全代理
VITE_AMAP_SECURITY_CODE=
# 可选：配置安全代理后优先使用，例如 https://your-domain/_AMapService
VITE_AMAP_SERVICE_HOST=
# 演示起终点，填可检索的真实地址或 POI；不使用虚构灾情地点导航
VITE_AMAP_ROUTE_ORIGIN=成都东站
VITE_AMAP_ROUTE_DESTINATION=都江堰市人民政府
VITE_AMAP_ROUTE_CITY=成都
